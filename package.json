{
  "name": "lexloop",
  "version": "1.23.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "dev:stop": "./stop.sh",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs",
    "test:updater": "node --test deploy/updater/*.test.mjs",
    "test:deploy": "node --test deploy/*.test.mjs deploy/updater/*.test.mjs",
    "db:generate": "pnpm --filter @lexloop/api prisma:generate",
    "db:migrate": "pnpm --filter @lexloop/api prisma:migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
