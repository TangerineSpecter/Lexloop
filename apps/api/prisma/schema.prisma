generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AiCallStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AiModelProvider {
  DEEPSEEK
  OPENAI_COMPATIBLE
}

enum VocabularyCategory {
  PRIMARY
  JUNIOR
  SENIOR
  COLLEGE
  EXAM
  MATERIAL
  PHRASES
  GENERAL
}

enum WordProgressState {
  NEW
  LEARNING
  REVIEWING
  MASTERED
}

enum StudyPlanStatus {
  GENERATING
  ACTIVE
  COMPLETED
  FAILED
}

enum StudyPlanMode {
  GROUP
  INDIVIDUAL
  EXAM
}

enum StudyPlanPurpose {
  NORMAL
  WEAKNESS
}

enum WeaknessStatus {
  ACTIVE
  IGNORED
  RESOLVED
}

enum TutorContextType {
  STUDY_GROUP
  MISTAKE
}

enum TutorMessageRole {
  USER
  ASSISTANT
}

enum TutorMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum StudyPlanItemSource {
  NEW
  REVIEW
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
}

enum ProfileConfidence {
  LOW
  MEDIUM
  HIGH
}

enum ProfileSnapshotSource {
  ASSESSMENT
  SCENARIO
  BACKFILLED_BASELINE
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum AssessmentItemType {
  VOCABULARY
  GRAMMAR
  SENTENCE_ORDER
  SCENARIO_RESPONSE
  FREE_RESPONSE
}

enum ScenarioCategory {
  AIRPORT
  HOTEL
  RESTAURANT
  SHOPPING
  TRANSPORT
  HELP
}

enum ScenarioSessionStatus {
  ACTIVE
  COMPLETED
}

enum ScenarioOutcome {
  SUCCESS
  PARTIAL
  INCOMPLETE
}

enum ScenarioTurnRole {
  USER
  ASSISTANT
}

enum VocabularyBookKind {
  SYSTEM
  PERSONAL
}

enum LexicalItemType {
  WORD
  PHRASE
}

enum LanguageSkillKind {
  GRAMMAR
  EXPRESSION
  PRAGMATICS
}

enum PracticeItemType {
  EXPRESSION_REVIEW
  GRAMMAR_REVIEW
  SCENARIO
}

enum AdventureRunStatus {
  ACTIVE
  COMPLETED
  FAILED
  RETREATED
}

enum AdventureRoomType {
  COMBAT
  ELITE
  EVENT
  CAMP
  TREASURE
  BOSS
}

enum AdventureRoomStatus {
  PENDING
  ACTIVE
  CLEARED
  FAILED
  SKIPPED
}

enum AdventureChallengeType {
  CHOICE
  SPELLING
  SENTENCE_ORDER
  MATCHING
  FREE_RESPONSE
}

enum AdventureActionPhase {
  ATTACK
  BLOCK
}

enum AdventureHitGrade {
  PERFECT
  HIT
  GRAZE
  MISS
}

enum AdventureEvidenceKind {
  RECOGNITION
  RECALL
  PRODUCTION
}

enum EquipmentSlot {
  WEAPON
  ARMOR
  ACCESSORY
}

enum EquipmentRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum SkillTarget {
  SELF
  ENEMY
  ALLY
  PARTY
}

enum AdventureQuestType {
  DUE_REVIEW
  WEAKNESS
  FREE_CHALLENGE
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  displayName    String?
  role           Role           @default(USER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]
  learningEvents LearningEvent[]
  aiCalls        AiCallAudit[]
  selectedAiModelId String?
  defaultNewWordCount Int @default(10)
  learningRecordsVersion Int @default(0)
  selectedAiModel AiModelConfig? @relation("UserSelectedAiModel", fields: [selectedAiModelId], references: [id], onDelete: SetNull)
  vocabularyBooks UserVocabularyBook[]
  wordProgresses  UserWordProgress[]
  masteredWords   UserMasteredWord[]
  studyPlans      StudyPlan[]
  weaknesses      WeaknessSignal[]
  tutorConversations TutorConversation[]
  tutorDailyUsages TutorDailyUsage[]
  ownedVocabularyBooks VocabularyBook[] @relation("OwnedVocabularyBooks")
  languageProfile LanguageProfile?
  assessmentAttempts AssessmentAttempt[]
  scenarioSessions ScenarioSession[]
  skillProgresses UserSkillProgress[]
  dailyPracticePlans DailyPracticePlan[]
  scenarioDailyUsages ScenarioDailyUsage[]
  languageProfileSnapshots LanguageProfileSnapshot[]
  learningAnalysisCache LearningAnalysisCache?
  adventureProfile AdventureProfile?
  adventureRuns DungeonRun[]
  adventureEvidence AdventureLearningEvidence[]
  adventureFloorProgresses UserFloorProgress[]
  inventoryItems InventoryItem[]
  adventureDailyQuests AdventureDailyQuest[]
  outputChallenges OutputChallenge[]
  confusionAttempts ConfusionAttempt[]
  dailySentences DailySentence[]
  labLessons LabLesson[]
  microProgress MicroProgress?
  microErrors MicroError[]
}

model MicroProgress {
  userId String @id
  completedKeys String[] @default([])
  interpretationKey String?
  interpretation String?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MicroError {
  id String @id @default(cuid())
  userId String
  lessonKey String
  interpretation String
  ownSentence String?
  reviewCount Int @default(0)
  dueAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonKey])
  @@index([userId, dueAt])
}

model SystemFeatureSetting {
  key String @id
  enabled Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model DailySentence {
  id String @id @default(cuid())
  userId String
  dateKey String
  status String @default("GENERATING")
  content Json?
  readAt DateTime?
  favorite Boolean @default(false)
  difficulty String?
  difficultyUpdatedAt DateTime?
  difficultyTimestampReliable Boolean @default(false)
  attempts Int @default(0)
  error String?
  generationToken String?
  generationStartedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, status, readAt, createdAt])
  @@index([userId, status, difficultyTimestampReliable, difficultyUpdatedAt], map: "DailySentence_feedback_time_idx")
}

model VocabularyBook {
  id          String             @id @default(cuid())
  sourceKey   String             @unique
  category    VocabularyCategory
  title       String
  sourcePath  String
  kind        VocabularyBookKind @default(SYSTEM)
  ownerId     String?
  publisher   String?
  grade       String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  bookWords   VocabularyBookWord[]
  userBooks   UserVocabularyBook[]
  owner       User?              @relation("OwnedVocabularyBooks", fields: [ownerId], references: [id], onDelete: Cascade)
  dungeonFloors DungeonFloor[]

  @@index([category, isActive])
  @@index([ownerId, kind])
}

model VocabularyWord {
  id          String             @id @default(cuid())
  normalized  String             @unique
  text        String
  ukPhonetic  String?
  usPhonetic  String?
  meaning     String?
  itemType    LexicalItemType @default(WORD)
  cefrLevel   CefrLevel?
  spokenPriority Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  bookWords   VocabularyBookWord[]
  masteredBy  UserMasteredWord[]
}

model VocabularyBookWord {
  id        String          @id @default(cuid())
  bookId    String
  wordId    String
  position  Int
  contextMeaning String?
  sourceScenario String?
  sourceExample String?
  sourceType String @default("TRAVEL")
  isCollected Boolean @default(true)
  book      VocabularyBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  word      VocabularyWord  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  progress  UserWordProgress[]
  studyPlanItems StudyPlanItem[]
  weaknesses WeaknessSignal[]
  floorTargets FloorLearningTarget[]

  @@unique([bookId, wordId])
  @@unique([bookId, position])
  @@index([wordId])
}

model LabLesson {
  id String @id @default(cuid())
  userId String
  kind String
  clientRequestId String
  status String @default("QUEUED")
  input Json
  content Json?
  answers Json?
  score Int?
  error String?
  workerTokenHash String
  leaseToken String?
  processingStartedAt DateTime?
  createdAt DateTime @default(now())
  completedAt DateTime?
  submittedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, kind, createdAt])
  @@index([userId, status, createdAt])
}

model UserVocabularyBook {
  id            String          @id @default(cuid())
  userId        String
  bookId        String
  isDefault     Boolean         @default(false)
  startedAt     DateTime        @default(now())
  lastStudiedAt DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          VocabularyBook  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, isDefault])
}

model UserWordProgress {
  id          String              @id @default(cuid())
  userId      String
  bookWordId  String
  state       WordProgressState   @default(NEW)
  familiarity Int                 @default(0)
  reviewCount Int                 @default(0)
  totalAttempts Int               @default(0)
  correctAttempts Int             @default(0)
  consecutiveCorrect Int          @default(0)
  lastIntervalDays Int            @default(0)
  postponedCount Int              @default(0)
  nextReviewAt DateTime?
  firstLearnedAt DateTime?
  lastReviewedAt DateTime?
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookWord    VocabularyBookWord  @relation(fields: [bookWordId], references: [id], onDelete: Cascade)

  @@unique([userId, bookWordId])
  @@index([userId, state, nextReviewAt])
}

model StudyPlan {
  id               String          @id @default(cuid())
  userId           String
  mode             StudyPlanMode   @default(GROUP)
  purpose          StudyPlanPurpose @default(NORMAL)
  status           StudyPlanStatus @default(GENERATING)
  generatedContent Json?
  generationError  String?
  generationStartedAt DateTime?
  generatedAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            StudyPlanItem[]
  tutorConversations TutorConversation[]

  @@index([userId, purpose, status, createdAt])
  @@index([userId, status, completedAt, id])
}

model StudyPlanItem {
  id          String              @id @default(cuid())
  planId      String
  bookWordId  String
  contentCacheId String?
  source      StudyPlanItemSource
  groupIndex  Int
  targetQuestionType String?
  question    Json?
  completedAt DateTime?
  plan        StudyPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  bookWord    VocabularyBookWord  @relation(fields: [bookWordId], references: [id], onDelete: Cascade)
  contentCache StudyContentCache? @relation(fields: [contentCacheId], references: [id], onDelete: SetNull)
  attempts    WordReviewAttempt[]

  @@unique([planId, bookWordId])
  @@index([planId, groupIndex])
  @@index([contentCacheId])
}

model WeaknessSignal {
  id                String         @id @default(cuid())
  userId            String
  bookWordId        String
  questionType      String
  status            WeaknessStatus @default(ACTIVE)
  wrongCount        Int            @default(1)
  consecutiveCorrect Int           @default(0)
  lastWrongAt       DateTime
  lastAttemptAt     DateTime
  resolvedAt        DateTime?
  ignoredAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookWord          VocabularyBookWord @relation(fields: [bookWordId], references: [id], onDelete: Cascade)
  tutorConversations TutorConversation[]

  @@unique([userId, bookWordId, questionType])
  @@index([userId, status, consecutiveCorrect, wrongCount, lastWrongAt])
}

model TutorConversation {
  id               String           @id @default(cuid())
  userId           String
  contextType      TutorContextType
  studyPlanId      String?
  groupIndex       Int?
  weaknessSignalId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlan        StudyPlan?       @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  weaknessSignal   WeaknessSignal?  @relation(fields: [weaknessSignalId], references: [id], onDelete: Cascade)
  messages         TutorMessage[]

  @@unique([userId, studyPlanId, groupIndex])
  @@unique([userId, weaknessSignalId])
  @@index([userId, contextType, updatedAt])
}

model TutorMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           TutorMessageRole
  status         TutorMessageStatus @default(COMPLETED)
  content        String             @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversation   TutorConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model TutorDailyUsage {
  id        String   @id @default(cuid())
  userId    String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
}

// AI-generated materials and questions are global reusable content. They do
// not belong to a user and survive deletion of personal learning records.
model StudyContentCache {
  id          String        @id @default(cuid())
  signature   String
  mode        StudyPlanMode
  material    Json
  hitCount    Int           @default(0)
  lastUsedAt  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  planItems   StudyPlanItem[]

  @@index([signature, mode, createdAt])
}

model WordReviewAttempt {
  id         String        @id @default(cuid())
  userId     String
  bookWordId String
  planItemId String?
  adventureActionId String? @unique
  isCorrect  Boolean
  questionType String?
  selectedAnswer Json?
  responseTimeMs Int?
  createdAt  DateTime      @default(now())
  item       StudyPlanItem? @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  adventureAction BattleAction? @relation(fields: [adventureActionId], references: [id], onDelete: Cascade)

  @@index([userId, bookWordId, createdAt])
  @@index([planItemId])
  @@index([userId, createdAt])
}

enum OutputStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model OutputChallenge {
  id          String   @id @default(cuid())
  userId      String
  challengeDate DateTime @db.Date
  prompt      String
  targets     Json
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions OutputSubmission[]

  @@unique([userId, challengeDate])
}

model OutputSubmission {
  id          String @id @default(cuid())
  challengeId String
  clientRequestId String
  answer      String @db.Text
  status      OutputStatus @default(QUEUED)
  workerTokenHash String
  leaseToken  String?
  processingStartedAt DateTime?
  feedback    Json?
  error       String?
  responseTimeMs Int @default(0)
  createdAt   DateTime @default(now())
  completedAt DateTime?
  challenge   OutputChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, clientRequestId])
  @@index([challengeId, createdAt])
}

model ConfusionAttempt {
  id          String @id @default(cuid())
  userId      String
  groupId     String
  clientRequestId String
  correctCount Int
  total       Int
  answers     Json
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([userId, groupId, createdAt])
}

// Mastery is tracked at the vocabulary-word level so a word stays mastered
// even when the learner later switches to another book containing it.
model UserMasteredWord {
  id         String         @id @default(cuid())
  userId     String
  wordId     String
  masteredAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([wordId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LearningEvent {
  id        String   @id @default(cuid())
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model KnowledgeChunk {
  id         String                 @id @default(cuid())
  sourceType String
  sourceId   String
  content    String
  metadata   Json?
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@index([sourceType, sourceId])
}

model AiCallAudit {
  id            String       @id @default(cuid())
  purpose       String
  provider      String?
  model         String?
  promptVersion String?
  status        AiCallStatus @default(PENDING)
  latencyMs     Int?
  estimatedCost Decimal?     @db.Decimal(12, 6)
  errorCode     String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AiModelConfig {
  id              String          @id @default(cuid())
  displayName     String
  provider        AiModelProvider
  model           String
  baseUrl         String
  encryptedApiKey String
  isEnabled       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  selectedByUsers User[]          @relation("UserSelectedAiModel")

  @@index([isEnabled, createdAt])
}

model LanguageProfile {
  id                    String            @id @default(cuid())
  userId                String            @unique
  overallLevel          CefrLevel         @default(A1)
  confidence            ProfileConfidence @default(LOW)
  vocabularyScore       Int               @default(0)
  grammarScore          Int               @default(0)
  sentenceBuildingScore Int               @default(0)
  taskCompletionScore   Int               @default(0)
  naturalnessScore      Int               @default(0)
  pronunciationScore    Int?
  listeningScore        Int?
  fluencyScore          Int?
  provisional           Boolean           @default(true)
  assessedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([overallLevel, confidence])
}

model LanguageProfileSnapshot {
  id                    String                @id @default(cuid())
  userId                String
  source                ProfileSnapshotSource
  sourceId              String
  overallLevel          CefrLevel
  confidence            ProfileConfidence
  vocabularyScore       Int
  grammarScore          Int
  sentenceBuildingScore Int
  taskCompletionScore   Int
  naturalnessScore      Int
  provisional           Boolean
  backfilled             Boolean               @default(false)
  recordedAt            DateTime
  createdAt             DateTime              @default(now())
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, sourceId])
  @@index([userId, recordedAt])
}

model LearningAnalysisCache {
  id          String   @id @default(cuid())
  userId      String   @unique
  inputHash   String
  content     Json
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentItem {
  id             String             @id
  version        Int                @default(1)
  type           AssessmentItemType
  level          CefrLevel
  dimension      String
  scenario       ScenarioCategory?
  prompt         String
  options        Json?
  correctAnswers Json?
  rubric         Json?
  explanation    String?
  displayOrder   Int
  isActive       Boolean            @default(true)
  responses      AssessmentResponse[]

  @@index([version, isActive, level, displayOrder])
}

model AssessmentAttempt {
  id              String           @id @default(cuid())
  userId          String
  status          AssessmentStatus @default(IN_PROGRESS)
  version         Int              @default(1)
  currentLevel    CefrLevel        @default(A2)
  objectiveLevel  CefrLevel?
  expressionLevel CefrLevel?
  confidence      ProfileConfidence?
  itemCount       Int              @default(0)
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses       AssessmentResponse[]

  @@index([userId, status, startedAt])
  @@index([userId, status, completedAt, id])
}

model AssessmentResponse {
  id          String            @id @default(cuid())
  attemptId   String
  itemId      String
  answer      Json
  isCorrect   Boolean?
  scores      Json?
  evidence    Json?
  provisional Boolean           @default(false)
  createdAt   DateTime          @default(now())
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  item        AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([attemptId, itemId])
  @@index([attemptId, createdAt])
}

model ScenarioTemplate {
  id                 String           @id
  slug               String           @unique
  category           ScenarioCategory
  title              String
  description        String
  userRole           String
  aiRole             String
  minTurns           Int              @default(6)
  maxTurns           Int              @default(10)
  objectives         Json
  starterPhrases     Json
  grammarFrames      Json
  difficultyVariants Json
  version            Int              @default(1)
  isActive           Boolean          @default(true)
  sessions           ScenarioSession[]
  practiceItems      DailyPracticePlanItem[]

  @@index([category, isActive])
}

model ScenarioSession {
  id                 String                @id @default(cuid())
  userId             String
  templateId         String
  level              CefrLevel
  status             ScenarioSessionStatus @default(ACTIVE)
  turnCount          Int                   @default(0)
  objectivesProgress Json?
  deferredFeedback   Json?
  processingMessageId String?
  processingStartedAt DateTime?
  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template           ScenarioTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  turns              ScenarioTurn[]
  report             ScenarioReport?

  @@index([userId, status, startedAt])
  @@index([userId, status, completedAt, id])
  @@index([templateId, completedAt])
}

model ScenarioTurn {
  id          String           @id @default(cuid())
  sessionId   String
  clientMessageId String?
  replyToTurnId String?          @unique
  role        ScenarioTurnRole
  content     String           @db.Text
  evaluation  Json?
  createdAt   DateTime         @default(now())
  session     ScenarioSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@unique([sessionId, clientMessageId])
}

model ScenarioReport {
  id               String          @id @default(cuid())
  sessionId        String          @unique
  outcome          ScenarioOutcome
  dimensionScores  Json
  rewrites         Json
  grammarFrames    Json
  evidence         Json
  vocabulary       Json
  recommendation   String
  createdAt        DateTime        @default(now())
  session          ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model LanguageSkill {
  id          String            @id
  code        String            @unique
  kind        LanguageSkillKind
  title       String
  level       CefrLevel
  description String
  progresses  UserSkillProgress[]
}

model UserSkillProgress {
  id              String        @id @default(cuid())
  userId          String
  skillId         String
  score           Int           @default(0)
  evidenceCount   Int           @default(0)
  consecutivePass Int           @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill           LanguageSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId, score, lastPracticedAt])
}

model DailyPracticePlan {
  id           String                  @id @default(cuid())
  userId       String
  planDate     DateTime                @db.Date
  totalMinutes Int                     @default(15)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        DailyPracticePlanItem[]

  @@unique([userId, planDate])
}

model DailyPracticePlanItem {
  id                 String             @id @default(cuid())
  planId             String
  type               PracticeItemType
  position           Int
  minutes            Int
  title              String
  reason             String
  scenarioTemplateId String?
  completedAt        DateTime?
  plan               DailyPracticePlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  scenarioTemplate   ScenarioTemplate?  @relation(fields: [scenarioTemplateId], references: [id], onDelete: SetNull)

  @@unique([planId, position])
  @@index([scenarioTemplateId])
}

model ScenarioDailyUsage {
  id        String   @id @default(cuid())
  userId    String
  usageDate DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
}

model AdventureProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  currentClassId String?
  level          Int         @default(1)
  experience     Int         @default(0)
  gold           Int         @default(0)
  materials      Int         @default(0)
  skillPoints    Int         @default(1)
  highestFloor   Int         @default(0)
  soundEnabled   Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentClass   ClassNode?  @relation(fields: [currentClassId], references: [id], onDelete: SetNull)
  skills         UserSkill[]

  @@index([currentClassId])
}

model ClassNode {
  id            String             @id
  key           String             @unique
  name          String
  description   String
  combatRole    String
  tier          Int
  requiredLevel Int
  parentId      String?
  sortOrder     Int                @default(0)
  isActive      Boolean            @default(true)
  parent        ClassNode?         @relation("ClassTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      ClassNode[]        @relation("ClassTree")
  profiles      AdventureProfile[]
  skills        SkillDefinition[]

  @@index([parentId, tier, sortOrder])
}

model SkillDefinition {
  id              String            @id
  key             String            @unique
  classNodeId     String
  name            String
  description     String
  target          SkillTarget
  cost            Int               @default(0)
  requiredLevel   Int               @default(1)
  requiredSkillId String?
  effect          Json
  sortOrder       Int               @default(0)
  classNode       ClassNode         @relation(fields: [classNodeId], references: [id], onDelete: Cascade)
  requiredSkill   SkillDefinition?  @relation("SkillPrerequisite", fields: [requiredSkillId], references: [id], onDelete: SetNull)
  dependents      SkillDefinition[] @relation("SkillPrerequisite")
  users           UserSkill[]

  @@index([classNodeId, requiredLevel, sortOrder])
}

model UserSkill {
  id         String           @id @default(cuid())
  profileId  String
  skillId    String
  rank       Int              @default(1)
  unlockedAt DateTime         @default(now())
  profile    AdventureProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill      SkillDefinition  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
}

model DungeonFloor {
  id             String                @id @default(cuid())
  bookId         String
  floorNumber    Int
  title          String
  cefrLevel      CefrLevel
  sentenceFrames Json
  version        Int                   @default(1)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  book           VocabularyBook        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  targets        FloorLearningTarget[]
  progresses     UserFloorProgress[]
  runs           DungeonRun[]
  quests         AdventureDailyQuest[]

  @@unique([bookId, floorNumber, version])
  @@index([bookId, isActive, floorNumber])
}

model FloorLearningTarget {
  id         String                      @id @default(cuid())
  floorId    String
  bookWordId String
  position   Int
  floor      DungeonFloor                @relation(fields: [floorId], references: [id], onDelete: Cascade)
  bookWord   VocabularyBookWord          @relation(fields: [bookWordId], references: [id], onDelete: Cascade)
  evidence   AdventureLearningEvidence[]

  @@unique([floorId, bookWordId])
  @@unique([floorId, position])
  @@index([bookWordId])
}

model UserFloorProgress {
  id             String       @id @default(cuid())
  userId         String
  floorId        String
  exploration    Int          @default(0)
  mastery        Int          @default(0)
  bossUnlocked   Boolean      @default(false)
  completedAt    DateTime?
  bestScore      Int          @default(0)
  lastExploredAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  floor          DungeonFloor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, floorId])
  @@index([userId, completedAt, lastExploredAt])
}

model DungeonRun {
  id               String                      @id @default(cuid())
  userId           String
  floorId          String
  status           AdventureRunStatus          @default(ACTIVE)
  durationMinutes  Int
  seed             String
  roomCount        Int
  currentRoom      Int                         @default(0)
  playerHp         Int                         @default(100)
  playerMaxHp      Int                         @default(100)
  resource         Int                         @default(3)
  experienceEarned Int                         @default(0)
  goldEarned       Int                         @default(0)
  materialsEarned  Int                         @default(0)
  securedItemId    String?
  snapshot         Json
  startedAt        DateTime                    @default(now())
  completedAt      DateTime?
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  floor            DungeonFloor                @relation(fields: [floorId], references: [id], onDelete: Restrict)
  rooms            DungeonRoom[]
  actions          BattleAction[]
  evidence         AdventureLearningEvidence[]
  acquiredItems    InventoryItem[]             @relation("AcquiredInRun")

  @@index([userId, status, startedAt])
  @@index([floorId, completedAt])
}

model DungeonRoom {
  id         String              @id @default(cuid())
  runId      String
  position   Int
  type       AdventureRoomType
  status     AdventureRoomStatus @default(PENDING)
  enemyName  String?
  enemyHp    Int?
  enemyMaxHp Int?
  challenge  Json?
  reward     Json?
  state      Json?
  run        DungeonRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  actions    BattleAction[]

  @@unique([runId, position])
}

model BattleAction {
  id             String                      @id @default(cuid())
  runId          String
  roomId         String
  clientActionId String
  phase          AdventureActionPhase
  skillId        String?
  challengeType  AdventureChallengeType
  answer         Json
  score          Int
  grade          AdventureHitGrade
  damageDealt    Int                         @default(0)
  damageReceived Int                         @default(0)
  feedback       Json
  responseTimeMs Int?
  createdAt      DateTime                    @default(now())
  run            DungeonRun                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  room           DungeonRoom                 @relation(fields: [roomId], references: [id], onDelete: Cascade)
  evidence       AdventureLearningEvidence[]
  reviewAttempt  WordReviewAttempt?

  @@unique([runId, clientActionId])
  @@index([roomId, createdAt])
}

model AdventureLearningEvidence {
  id          String                @id @default(cuid())
  userId      String
  targetId    String
  runId       String
  actionId    String
  kind        AdventureEvidenceKind
  score       Int
  validRecall Boolean               @default(false)
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  target      FloorLearningTarget   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  run         DungeonRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  action      BattleAction          @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@unique([actionId, targetId])
  @@index([userId, targetId, createdAt])
}

model EquipmentDefinition {
  id          String          @id
  key         String          @unique
  name        String
  description String
  slot        EquipmentSlot
  rarity      EquipmentRarity
  minFloor    Int             @default(1)
  baseStats   Json
  isActive    Boolean         @default(true)
  items       InventoryItem[]

  @@index([slot, rarity, minFloor])
}

model InventoryItem {
  id            String              @id @default(cuid())
  userId        String
  definitionId  String
  acquiredRunId String?
  stats         Json
  durability    Int                 @default(100)
  equipped      Boolean             @default(false)
  secured       Boolean             @default(false)
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition    EquipmentDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  acquiredRun   DungeonRun?         @relation("AcquiredInRun", fields: [acquiredRunId], references: [id], onDelete: SetNull)

  @@index([userId, equipped, createdAt])
  @@index([acquiredRunId])
}

model AdventureDailyQuest {
  id          String             @id @default(cuid())
  userId      String
  questDate   DateTime           @db.Date
  type        AdventureQuestType
  floorId     String?
  title       String
  description String
  targetCount Int
  progress    Int                @default(0)
  reward      Json
  claimedAt   DateTime?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  floor       DungeonFloor?      @relation(fields: [floorId], references: [id], onDelete: SetNull)

  @@unique([userId, questDate, type])
  @@index([userId, questDate, claimedAt])
}
